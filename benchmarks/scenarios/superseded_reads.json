{
  "name": "superseded_reads",
  "description": "Repeated changed reads compare step-boundary pruning with control. Four reads of a 30 KB file fill the fixed 64 KiB protected window, so the oldest are archived and the latest evidence retained.",
  "tier": "regression",
  "variants": [
    "control",
    "pruned"
  ],
  "yolo": true,
  "variant_env": {
    "control": {
      "UAGENT_PRUNE_SUPERSEDED_READS": "0"
    },
    "pruned": {
      "UAGENT_PRUNE_SUPERSEDED_READS": "1"
    }
  },
  "prompt": "Read notes.txt, then change its marker from OLD-MARKER to MID-MARKER-1 to MID-MARKER-2 to NEW-MARKER, rereading the file after each change, and verify NEW-MARKER is present.",
  "files": {
    "notes.txt": {
      "text": "OLD-MARKER\n",
      "repeat_text": "row {index:03d}: durable evidence padding abcdefghijklmnopqrstuvwxyz\n",
      "repeat": 400
    }
  },
  "script": [
    {
      "when": {
        "tool_results": 0
      },
      "respond": {
        "tool_calls": [
          {
            "id": "before",
            "name": "read_path",
            "arguments": {
              "path": "notes.txt"
            }
          }
        ]
      }
    },
    {
      "when": {
        "tool_results": 1
      },
      "respond": {
        "tool_calls": [
          {
            "id": "edit-1",
            "name": "edit_file",
            "arguments": {
              "path": "notes.txt",
              "edits": [
                {
                  "old": "OLD-MARKER",
                  "new": "MID-MARKER-1"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "when": {
        "tool_results": 2
      },
      "respond": {
        "tool_calls": [
          {
            "id": "after-1",
            "name": "read_path",
            "arguments": {
              "path": "notes.txt"
            }
          }
        ]
      }
    },
    {
      "when": {
        "tool_results": 3
      },
      "respond": {
        "tool_calls": [
          {
            "id": "edit-2",
            "name": "edit_file",
            "arguments": {
              "path": "notes.txt",
              "edits": [
                {
                  "old": "MID-MARKER-1",
                  "new": "MID-MARKER-2"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "when": {
        "tool_results": 4
      },
      "respond": {
        "tool_calls": [
          {
            "id": "after-2",
            "name": "read_path",
            "arguments": {
              "path": "notes.txt"
            }
          }
        ]
      }
    },
    {
      "when": {
        "tool_results": 5
      },
      "respond": {
        "tool_calls": [
          {
            "id": "edit-3",
            "name": "edit_file",
            "arguments": {
              "path": "notes.txt",
              "edits": [
                {
                  "old": "MID-MARKER-2",
                  "new": "NEW-MARKER"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "when": {
        "tool_results": 6
      },
      "respond": {
        "tool_calls": [
          {
            "id": "after-3",
            "name": "read_path",
            "arguments": {
              "path": "notes.txt"
            }
          }
        ]
      }
    },
    {
      "when": {
        "tool_results": 7
      },
      "respond": {
        "tool_calls": [
          {
            "id": "check",
            "name": "grep",
            "arguments": {
              "path": "notes.txt",
              "pattern": "NEW-MARKER"
            }
          }
        ]
      }
    },
    {
      "respond": {
        "content": "Verified NEW-MARKER in notes.txt."
      }
    }
  ],
  "checks": {
    "workspace_unchanged": false,
    "answer_contains": [
      "NEW-MARKER"
    ],
    "max_requests": 9,
    "max_tool_calls": 8
  }
}
