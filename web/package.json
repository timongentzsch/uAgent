{
  "name": "uagent-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-state.js capture && npm run typecheck && UAGENT_WEB_OUT_DIR=dist.next vite build && node scripts/promote-dist.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:spec": "playwright test --project=chromium --retries=0 -x",
    "format": "biome format --write",
    "format:check": "biome format",
    "notices": "node scripts/notices.js",
    "size": "node scripts/size.js",
    "icons": "node scripts/icons.js",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json"
  },
  "dependencies": {
    "@mdit/plugin-katex": "1.1.4",
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "lucide-preact": "1.62.0",
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0",
    "perfect-freehand": "1.2.3",
    "preact": "11.0.1"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "mermaid": {
      "katex": "$katex"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "axe-core": "4.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
