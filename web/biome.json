{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "assist": {
    "enabled": false
  },
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "public/*.js",
      "*.js",
      "*.json",
      "!package-lock.json"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "reportUnnecessaryDependencies": false,
            "hooks": [
              {
                "name": "useLatest",
                "stableResult": true
              },
              {
                "name": "useStored",
                "stableResult": [1]
              },
              {
                "name": "useResource",
                "stableResult": ["setValue", "setError"]
              },
              {
                "name": "useHost",
                "stableResult": [
                  "snapshots",
                  "setDrafts",
                  "setError",
                  "setOutgoing",
                  "setFollowing"
                ]
              }
            ]
          }
        },
        "useHookAtTopLevel": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  }
}
