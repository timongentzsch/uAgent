{
  "name": "uagent-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts public/*.js *.js *.json index.html",
    "format:check": "prettier --check src tests scripts public/*.js *.js *.json index.html",
    "notices": "node scripts/notices.js",
    "size": "node scripts/size.js",
    "icons": "node scripts/icons.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json"
  },
  "dependencies": {
    "@mdit/plugin-katex": "1.1.1",
    "highlight.js": "11.12.0",
    "katex": "0.18.7",
    "lucide-preact": "1.42.0",
    "markdown-it": "15.0.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
