{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "vcs": { "enabled": false },
  "files": { "includes": ["src/**", "tests/**", "scripts/**"] },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "reportUnnecessaryDependencies": false,
            "hooks": [
              { "name": "useLatest", "stableResult": true },
              {
                "name": "useResource",
                "stableResult": ["setValue", "setError"]
              },
              {
                "name": "useHost",
                "stableResult": [
                  "snapshots",
                  "setDrafts",
                  "setError",
                  "setOutgoing",
                  "setFollowing"
                ]
              }
            ]
          }
        },
        "useHookAtTopLevel": "error"
      }
    }
  }
}
