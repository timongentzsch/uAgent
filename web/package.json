{
  "name": "uagent-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && UAGENT_WEB_OUT_DIR=dist.next vite build && node scripts/promote-dist.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:spec": "playwright test --project=chromium --retries=0 -x",
    "format": "prettier --write src tests scripts public/*.js *.js *.json *.html",
    "format:check": "prettier --check src tests scripts public/*.js *.js *.json *.html",
    "notices": "node scripts/notices.js",
    "size": "node scripts/size.js",
    "icons": "node scripts/icons.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json"
  },
  "dependencies": {
    "@mdit/plugin-katex": "1.1.3",
    "@novnc/novnc": "1.7.0",
    "highlight.js": "11.12.0",
    "katex": "0.19.0",
    "lucide-preact": "1.52.0",
    "markdown-it": "15.0.2",
    "mermaid": "12.1.0",
    "perfect-freehand": "1.2.3",
    "preact": "10.29.8"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "mermaid": {
      "katex": "$katex"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.13.3",
    "axe-core": "4.13.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
